[editor]
line_wrapping=false
line_break_column=72
auto_continue_multiline=true

[file_prefs]
final_new_line=true
ensure_convert_new_lines=false
strip_trailing_spaces=false
replace_tabs=false

[indentation]
indent_width=4
indent_type=1
indent_hard_tab_width=8
detect_indent=false
detect_indent_width=false
indent_mode=2

[project]
name=Labyrinth
base_path=.
description=
file_patterns=

[long line marker]
long_line_behaviour=1
long_line_column=72

[files]
current_page=-1

[build-menu]
filetypes=Java;
JavaFT_00_LB=Compile Project
JavaFT_00_CM=powershell -NoProfile -ExecutionPolicy Bypass -Command "New-Item -ItemType Directory -Force out | Out-Null; javac -d out (Get-ChildItem -Path labyrinth\\src -Recurse -Filter *.java | ForEach-Object { $_.FullName })"
JavaFT_00_WD=%p
JavaFT_01_LB=Run GUI
JavaFT_01_CM=java -cp out game.main.GuiMain
JavaFT_01_WD=%p
JavaFT_02_LB=
JavaFT_02_CM=
JavaFT_02_WD=
